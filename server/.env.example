PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection URI or local MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/freelance_studio

# JWT Secret & Expiration
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d

# Default Initial Administrator Credentials
DEFAULT_ADMIN_EMAIL=admin@tejastudio.com
DEFAULT_ADMIN_PASSWORD=AdminPassword123!
DEFAULT_ADMIN_NAME="Studio Admin"

# Email Configuration (Nodemailer SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Teja Web Studio <hello@tejastudio.com>"
ADMIN_NOTIFICATION_EMAIL=admin@tejastudio.com
EMAIL_SERVICE_ENABLED=false
